<!--indicator-select.wxml-->
<navigation-bar title="选择指标" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page-container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜索指标名称"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>
    <view class="selection-info">
      <text class="info-text">已选择 {{selectedCount}}/{{maxSelection}}</text>
      <text wx:if="{{selectedCount > 0}}" class="clear-button" bindtap="clearSelection">清空</text>
    </view>
  </view>

  <!-- 指标列表 -->
  <scroll-view class="scrollarea" scroll-y type="list">
    <view class="container">
      <!-- 加载中 -->
      <view wx:if="{{loading}}" class="loading-state">
        <loading></loading>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{filteredIndicators.length === 0}}" class="empty-state">
        <text class="empty-icon">🔍</text>
        <text class="empty-text">{{searchKeyword ? '没有找到相关指标' : '暂无指标数据'}}</text>
      </view>

      <!-- 指标列表 -->
      <view wx:else class="indicator-list">
        <view
          wx:for="{{filteredIndicators}}"
          wx:key="index"
          class="indicator-item {{item.selected ? 'selected' : ''}} {{selectedCount >= maxSelection && !item.selected ? 'disabled' : ''}}"
          data-index="{{index}}"
          bindtap="toggleSelect"
        >
          <view class="indicator-info">
            <text class="indicator-name">{{item.name}}</text>
            <text class="indicator-meta">{{item.unit}} · {{item.count}} 条记录</text>
          </view>
          <view class="indicator-checkbox">
            <text wx:if="{{item.selected}}" class="checkbox-icon checked">✓</text>
            <text wx:else class="checkbox-icon"></text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部按钮 -->
  <view class="footer-buttons">
    <button class="confirm-button" bindtap="confirmSelection">
      查看趋势图 ({{selectedCount}})
    </button>
  </view>
</view>
